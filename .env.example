NODE_ENV=development
APP_NAME=pawnshop
# local/dev: 3001; production (VPS): 3019
APP_PORT=3001

DB_TYPE=postgres
# localhost OK for npm-dev and VPS (host network).
# Docker DEV: IS_DOCKER=TRUE rewrites localhost → host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pawnshop_test

# local/dev web: 3017; production: https origin (CORS), without /pawnshop path
WEB_ORIGIN=http://localhost:3017

# --- VPS /var/www/portfolio.am-projects.ru/pawnshop/.env ---
# NODE_ENV=production
# APP_PORT=3019
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=<password>
# DB_DATABASE=pawnshop
# WEB_ORIGIN=https://portfolio.am-projects.ru
# AUTO_SEED=false
#
# VITE_* are NOT set here — they are baked into the web image at CI build time
# (GitHub secrets VITE_API_BASE_URL, VITE_BASE_PATH).
