{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "outDir": "./dist",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "./shared/*"
      ],
      "@api/*": [
        "./api/src/*"
      ],
      "@infrastructure/*": [
        "./api/src/infrastructure/*"
      ],
      "@web/*": [
        "./web/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "api/dist",
    "web/dist"
  ]
}
